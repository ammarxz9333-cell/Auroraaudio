        FilledButton.tonalIcon(onPressed: () => ctl.toggleSaved(art), icon: Icon(saved ? Icons.bookmark : Icons.bookmark_border), label: Text(saved ? 'Saved' : 'Save')),
        FilledButton.tonalIcon(onPressed: downloading ? null : () => download(art), icon: const Icon(Icons.download_outlined), label: Text(downloading ? 'Downloading…' : 'Download')),
        FilledButton.tonalIcon(onPressed: () async { await Clipboard.setData(ClipboardData(text: art.pageUri.toString())); }, icon: const Icon(Icons.copy), label: const Text('Copy link')),
      ])),
      if (art.tags.isNotEmpty) ...[
        const Divider(height: 28),
        Padding(padding: const EdgeInsets.symmetric(horizontal: 12), child: Wrap(spacing: 6, runSpacing: 6,
          children: art.tags.take(24).map((t) => ActionChip(label: Text(t.replaceAll('_', ' ')),
            onPressed: () => context.push('/artsource?q=${Uri.encodeQueryComponent(t)}'))).toList())),
      ],
      const Divider(height: 30),
      const Padding(padding: EdgeInsets.symmetric(horizontal: 16), child: Text('More like this · across sources')),
      SizedBox(height: 260, child: related.when(
        loading: () => const Center(child: CircularProgressIndicator()),
        error: (_, __) => const Center(child: Text('Related images unavailable.')),
        data: (list) => ListView.separated(scrollDirection: Axis.horizontal, padding: const EdgeInsets.all(10),
          itemCount: list.take(18).length, separatorBuilder: (_, __) => const SizedBox(width: 8),
          itemBuilder: (_, i) => SizedBox(width: 160, child: ArtTile(list[i]))),
      )),
      const Divider(height: 30),
      const Padding(padding: EdgeInsets.symmetric(horizontal: 16), child: Text('Artists you may like')),
