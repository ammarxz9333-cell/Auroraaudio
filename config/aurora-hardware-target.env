# Aurora hardware target manifest
#
# MACHINE-READABLE SOURCE OF TRUTH for the currently selected realtime MCU.
# Runtime/build/CI/docs must use the symbolic AURORA_REALTIME_MCU_* and
# AURORA_PIN_* names and must not infer the active part or pin map elsewhere.
#
# To change MCU/package later, update this file first. Portable Aurora
# protocol/audio code must remain unchanged unless the replacement lacks a
# required capability.

AURORA_REALTIME_MCU_ROLE=aurora-realtime-mcu
AURORA_REALTIME_MCU_VENDOR=STMicroelectronics
AURORA_REALTIME_MCU_FAMILY=STM32H7
AURORA_REALTIME_MCU_PART=STM32H723ZGI6
AURORA_REALTIME_MCU_PACKAGE=UFBGA144

# Portable firmware currently lives in this historical directory. The directory
# name is NOT target truth and must never be used to decide which MCU is active.
AURORA_REALTIME_MCU_SOURCE_DIR=firmware/stm32h753

# Required capabilities for the selected target. CI/HAL bring-up must fail
# closed if a future replacement cannot satisfy all mandatory requirements.
AURORA_REALTIME_MCU_USB_HS_HOST=1
AURORA_REALTIME_MCU_USB_HS_PHY=ULPI
AURORA_REALTIME_MCU_ULPI_DIRECT_PINS=1
AURORA_REALTIME_MCU_SAI_RX=1
AURORA_REALTIME_MCU_SAI_TDM_TX=1
AURORA_REALTIME_MCU_DMA=1
AURORA_REALTIME_MCU_SPDIFRX=1

# Canonical Aurora realtime transport shape. These mirror protocol-v1 and exist
# here so hardware-target validation has no part-number-specific constants.
AURORA_REALTIME_MCU_SAMPLE_RATE=48000
AURORA_REALTIME_MCU_CHANNELS=12
AURORA_REALTIME_MCU_PERIOD_FRAMES=40

# USB 2.0 HS ULPI: all signals use direct digital GPIO balls on the selected
# UFBGA144 package. AF10 is the OTG_HS ULPI alternate function on these pins.
AURORA_PIN_ULPI_STP=PC0
AURORA_BALL_ULPI_STP=H1
AURORA_AF_ULPI_STP=10
AURORA_PIN_ULPI_DIR=PC2
AURORA_BALL_ULPI_DIR=H3
AURORA_AF_ULPI_DIR=10
AURORA_PIN_ULPI_NXT=PC3
AURORA_BALL_ULPI_NXT=H4
AURORA_AF_ULPI_NXT=10
AURORA_PIN_ULPI_CLK=PA5
AURORA_BALL_ULPI_CLK=K3
AURORA_AF_ULPI_CLK=10
AURORA_PIN_ULPI_D0=PA3
AURORA_BALL_ULPI_D0=M2
AURORA_AF_ULPI_D0=10
AURORA_PIN_ULPI_D1=PB0
AURORA_BALL_ULPI_D1=L4
AURORA_AF_ULPI_D1=10
AURORA_PIN_ULPI_D2=PB1
AURORA_BALL_ULPI_D2=M4
AURORA_AF_ULPI_D2=10
AURORA_PIN_ULPI_D3=PB10
AURORA_BALL_ULPI_D3=M9
AURORA_AF_ULPI_D3=10
AURORA_PIN_ULPI_D4=PB11
AURORA_BALL_ULPI_D4=M10
AURORA_AF_ULPI_D4=10
AURORA_PIN_ULPI_D5=PB12
AURORA_BALL_ULPI_D5=M11
AURORA_AF_ULPI_D5=10
AURORA_PIN_ULPI_D6=PB13
AURORA_BALL_ULPI_D6=M12
AURORA_AF_ULPI_D6=10
AURORA_PIN_ULPI_D7=PB5
AURORA_BALL_ULPI_D7=B6
AURORA_AF_ULPI_D7=10

# eARC IEC61937 capture from the external receiver: SAI1 block A, external
# clock/frame-sync slave receiver. MCLK is intentionally not required.
AURORA_EARC_SAI_INSTANCE=SAI1
AURORA_EARC_SAI_BLOCK=A
AURORA_PIN_EARC_FS=PE4
AURORA_BALL_EARC_FS=B2
AURORA_AF_EARC_FS=6
AURORA_PIN_EARC_SCK=PE5
AURORA_BALL_EARC_SCK=B3
AURORA_AF_EARC_SCK=6
AURORA_PIN_EARC_SD=PE6
AURORA_BALL_EARC_SD=B4
AURORA_AF_EARC_SD=6

# 7.1.4 PCM output: SAI4 block A in TDM mode. The SAI supports TDM and up to
# 16 slots; Aurora currently uses 12 active 32-bit slots at 48 kHz.
AURORA_TDM_SAI_INSTANCE=SAI4
AURORA_TDM_SAI_BLOCK=A
AURORA_PIN_TDM_FS=PD12
AURORA_BALL_TDM_FS=L10
AURORA_AF_TDM_FS=10
AURORA_PIN_TDM_SCK=PD13
AURORA_BALL_TDM_SCK=K10
AURORA_AF_TDM_SCK=10
AURORA_PIN_TDM_SD=PD11
AURORA_BALL_TDM_SD=H9
AURORA_AF_TDM_SD=10
AURORA_PIN_TDM_MCLK=PE0
AURORA_BALL_TDM_MCLK=A5
AURORA_AF_TDM_MCLK=10

# Reserved fail-closed control GPIOs. These are plain GPIO assignments and do
# not consume alternate-function routing.
AURORA_PIN_USB_PHY_RESET=PG0
AURORA_BALL_USB_PHY_RESET=K6
AURORA_PIN_AMP_MUTE=PE1
AURORA_BALL_AMP_MUTE=A4

# Pinmux proof sources. Concrete pin values above were checked against the
# current ST datasheet alternate-function tables. Package-specific electrical
# behavior is why UFBGA144 is selected instead of the LQFP144 _C-pin route.
AURORA_REALTIME_MCU_PINMUX_PROOF=ST_DS13313_REV5_TABLE7_TABLE8
AURORA_REALTIME_MCU_PINMUX_STATUS=datasheet_verified
AURORA_REALTIME_MCU_HAL_STATUS=not_implemented
AURORA_REALTIME_MCU_PHYSICAL_STATUS=not_measured
