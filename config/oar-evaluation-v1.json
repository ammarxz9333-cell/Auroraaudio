{
  "schema_version": 1,
  "reference": {
    "id": "aomedia-oar",
    "upstream": "https://github.com/AOMediaCodec/oar",
    "version": "1.0.0",
    "commit": "5601d50c05a5e71cac7e80babeff7dd2a53b2060",
    "license": "BSD-3-Clause-Clear",
    "patent_file_required": true,
    "integration": "external-reference-only",
    "build": {
      "generator": "cmake",
      "build_examples": true,
      "enable_binauralizer": true,
      "enable_hoa_lfe": false
    }
  },
  "acceptance": {
    "exact_commit_required": true,
    "upstream_tests_required": true,
    "license_and_patents_required": true,
    "promotion_to_aurora_coverage_requires_differential_evidence": true
  },
  "differential": {
    "slice": "stereo-object-position-gain-v1",
    "layout": "stereo",
    "sample_rate": 48000,
    "frames_per_case": 256,
    "channel_order": [
      "FL",
      "FR"
    ],
    "cases": [
      "left_unity",
      "center_unity",
      "right_unity",
      "center_minus_6db"
    ],
    "expected_gain_db": -6.0,
    "normalized_channel_tolerance": 0.02,
    "center_balance_tolerance": 0.02,
    "dominance_margin": 0.8,
    "gain_db_tolerance": 0.1,
    "cross_renderer_gain_db_tolerance": 0.02
  },
  "truth_boundary": "Successful upstream build/tests plus the focused stereo semantic differential establish only object-position/gain, finite-output, frame-accounting, and FL/FR ordering evidence against the exact pinned OAR reference. They do not prove IAMF ingestion or decoding, 5.1/7.1.4 differential equivalence, raw PCM identity, physical output, proprietary-format equivalence, or certification."
}
