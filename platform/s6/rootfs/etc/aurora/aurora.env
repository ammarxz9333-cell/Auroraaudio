# AuroraOS-S6 pinned integration manifest
AURORA_PLATFORM=s6
AURORA_ARCH=aarch64
AURORA_SAMPLE_RATE=48000
AURORA_BLOCK_FRAMES=40
AURORA_LAYOUT=7.1.4

# Third-party adapters are external processes and must remain replaceable.
HARLETTY_VERSION=v0.7.4
OMNIPHONY_VERSION=v0.5.2
NAVIDROME_VERSION=v0.63.2

AURORA_BIN=/usr/local/bin/aurora-cli
AURORA_POSTPROCESS_BIN=/usr/local/bin/aurora-s6-postprocess
AURORA_LIVE_INGEST_BIN=/usr/local/sbin/aurora-live-ingest
HARLETTY_BIN=/opt/aurora/external/libharletty_bridge.so
OMNIPHONY_BIN=/opt/aurora/external/orender
NAVIDROME_BIN=/opt/aurora/navidrome/navidrome

# Safe initial speaker-processing defaults. These are configuration, not
# physical calibration evidence. LFE trim deliberately remains 0 dB until the
# complete decoder/render/output chain is level-calibrated on hardware.
AURORA_BED_CROSSOVER_HZ=80
AURORA_HEIGHT_CROSSOVER_HZ=100
AURORA_LFE_LOWPASS_HZ=120
AURORA_SUB_HIGHPASS_HZ=20
AURORA_LFE_TRIM_DB=0
AURORA_REDIRECTED_BASS_DB=0
AURORA_HEADROOM_DB=-3
AURORA_LIMITER_DBFS=-1
AURORA_LIMITER_RELEASE_MS=50
AURORA_DRIFT_TARGET_FRAMES=120
AURORA_LIPSYNC_MS=0

AURORA_CONFIG=/etc/aurora/aurora.toml
AURORA_STATE=/var/lib/aurora
AURORA_MUSIC=/srv/music
AURORA_LOG=/var/log/aurora
