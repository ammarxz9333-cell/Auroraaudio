#!/sbin/openrc-run

# The live audio service has one runtime configuration source. Exporting the
# manifest here also passes the same values to the broker and its children.
AURORA_CONFIG_MISSING=0
if [ -r /etc/aurora/aurora.env ]; then
    set -a
    . /etc/aurora/aurora.env
    set +a
else
    AURORA_CONFIG_MISSING=1
    # Keep OpenRC's command field valid; start_pre rejects this state before
    # anything can run.
    AURORA_LIVE_INGEST_BIN=/bin/false
fi

name="Aurora live immersive ingest"
description="Live DD+ IEC61937 to Harletty/Omniphony/Aurora DSP 7.1.4 pipeline"
command="$AURORA_LIVE_INGEST_BIN"
command_background="yes"
pidfile="/run/aurora/aurora-live-ingest.pid"
output_log="/var/log/aurora/aurora-live-ingest.log"
error_log="/var/log/aurora/aurora-live-ingest.log"

depend() {
    need aurora-ffs aurora-source-manager
    after localmount
}

start_pre() {
    [ "$AURORA_CONFIG_MISSING" -eq 0 ] || return 1
    checkpath --directory --mode 0755 /run/aurora
    checkpath --directory --mode 0755 /var/log/aurora
    [ -x "$AURORA_LIVE_INGEST_BIN" ] || return 1
    [ -x "$AURORA_POSTPROCESS_BIN" ] || return 1
    [ -x "$AURORA_ORENDER_BIN" ] || return 1
    [ -f "$AURORA_HARLETTY_BRIDGE" ] || return 1
    [ -f "$AURORA_7_1_4_LAYOUT" ] || return 1
    [ -n "${AURORA_SOURCE_MANAGER_SOCKET:-}" ] || return 1
    [ "${AURORA_BLOCK_FRAMES:-0}" = "40" ] || return 1
    [ "${AURORA_SAMPLE_RATE:-0}" = "48000" ] || return 1
}
