#!/sbin/openrc-run

name="Aurora FunctionFS transport"
description="Galaxy S6 USB gadget bridge for Aurora realtime-MCU transport"
command="/usr/local/sbin/aurora-ffs-daemon"
command_background="yes"
pidfile="/run/aurora/aurora-ffs.pid"
output_log="/var/log/aurora/aurora-ffs.log"
error_log="/var/log/aurora/aurora-ffs.log"

 depend() {
    need localmount
    before networking
}

start_pre() {
    checkpath --directory --mode 0755 /dev/ffs-aurora
    checkpath --directory --mode 0755 /run/aurora
    checkpath --directory --mode 0755 /var/log/aurora

    if ! mountpoint -q /dev/ffs-aurora; then
        mount -t functionfs aurora /dev/ffs-aurora || return 1
    fi
}

stop_post() {
    if mountpoint -q /dev/ffs-aurora; then
        umount /dev/ffs-aurora || true
    fi
}
