#!/sbin/openrc-run

AURORA_CONFIG_MISSING=0
if [ -r /etc/aurora/aurora.env ]; then
    set -a
    . /etc/aurora/aurora.env
    set +a
else
    AURORA_CONFIG_MISSING=1
    AURORA_SOURCE_GATE_BIN=/bin/false
fi

name="Aurora source gate"
description="Single-backend source data mux and fail-closed HDMI PCM gate before FunctionFS"
command="$AURORA_SOURCE_GATE_BIN"
command_background="yes"
pidfile="/run/aurora/aurora-source-gate.pid"
output_log="/var/log/aurora/aurora-source-gate.log"
error_log="/var/log/aurora/aurora-source-gate.log"

depend() {
    need aurora-ffs aurora-source-manager
    after localmount
}

start_pre() {
    [ "$AURORA_CONFIG_MISSING" -eq 0 ] || return 1
    checkpath --directory --mode 0755 /run/aurora
    checkpath --directory --mode 0755 /var/log/aurora
    [ -x "$AURORA_SOURCE_GATE_BIN" ] || return 1
    [ -n "${AURORA_SOURCE_MANAGER_SOCKET:-}" ] || return 1
    [ -n "${AURORA_HDMI_SOURCE_SOCKET:-}" ] || return 1
    [ -n "${AURORA_LOCAL_SOURCE_SOCKET:-}" ] || return 1
    [ -n "${AURORA_USB_BRIDGE_SOCKET_REAL:-}" ] || return 1
    [ "$AURORA_USB_BRIDGE_SOCKET" = "$AURORA_HDMI_SOURCE_SOCKET" ] || return 1
}
