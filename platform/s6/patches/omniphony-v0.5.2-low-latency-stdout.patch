+    fn raw_stdout_buffer_capacity(channel_count: u32) -> usize {
+        Self::LOW_LATENCY_STDOUT_FRAMES
+            .saturating_mul(channel_count as usize)
+            .saturating_mul(std::mem::size_of::<f32>())
+            .max(1)
+    }
 
     /// Open `destination` (`"-"` for stdout, otherwise a regular file or FIFO
     /// path) and, for CAF, write the header immediately.
     pub fn new(
         destination: &str,
         format: FileSinkFormat,
         sample_rate: u32,
         channel_count: u32,
         channel_descs: Option<Vec<CafChannelDesc>>,
     ) -> io::Result<Self> {
+        if destination == "-" && format == FileSinkFormat::RawF32 {
+            let sink: Box<dyn Write + Send> = Box::new(io::stdout());
+            let inner = BufWriter::with_capacity(
+                Self::raw_stdout_buffer_capacity(channel_count),
+                sink,
+            );
+            return Ok(Self {
+                inner,
+                byte_scratch: Vec::new(),
+            });
+        }
+
         let sink: Box<dyn Write + Send> = if destination == "-" {
             Box::new(io::stdout())
         } else {
             // A FIFO opens like a regular file and blocks until a reader
             // attaches — that is the intended backpressure. `truncate` is a
             // no-op on FIFOs and gives a fresh capture for regular files.
             Box::new(
                 OpenOptions::new()
                     .write(true)
                     .create(true)
                     .truncate(true)
                     .open(destination)?,
             )
         };
         Self::with_writer(sink, format, sample_rate, channel_count, channel_descs)
     }
