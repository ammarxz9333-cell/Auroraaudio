# Copy to ~/.config/aurora/r0.env for the dedicated Aurora appliance user.
# Paths below assume the repository is installed at /opt/aurora and pinned
# third-party sources are built under /opt/aurora-deps.
AURORA_EARC_DEVICE=hw:AuroraEARC,0
AURORA_TDM_ALSA_DEVICE=hw:AuroraTDM16,0
AURORA_OUTPUT_DEVICE=aurora_tdm
AURORA_DEPS_ROOT=/opt/aurora-deps
AURORA_EXTRACTOR=/opt/aurora/target/release/aurora-iec61937-extract
AURORA_HARLETTY_BRIDGE=/opt/aurora-deps/harletty-bridge/target/release/libharletty_bridge.so
AURORA_ORENDER=/opt/aurora-deps/Omniphony/omniphony-renderer/target/release/orender
AURORA_SPEAKER_LAYOUT=/opt/aurora/platforms/imx93/layouts/aurora-7.1.4.yaml

# Doctor keeps playback probing disabled by default for speaker safety. Enable
# only while both amplifier boards are physically hard-muted.
AURORA_PROBE_PLAYBACK=0
