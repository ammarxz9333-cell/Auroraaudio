[Unit]
Description=Aurora i.MX93 R0 eARC JOC to 7.1.4 pipeline
After=pipewire.service wireplumber.service sound.target
Wants=pipewire.service wireplumber.service
ConditionPathExists=/opt/aurora/scripts/imx93/run-live-714.sh

[Service]
Type=simple
EnvironmentFile=-%h/.config/aurora/r0.env
WorkingDirectory=/opt/aurora
ExecStart=/opt/aurora/scripts/imx93/run-live-714.sh
Restart=on-failure
RestartSec=2

# This is a USER unit on purpose: Omniphony targets the same per-user PipeWire
# graph managed by PipeWire/WirePlumber. Realtime audio scheduling is delegated
# to PipeWire/RTKit rather than granting the Aurora shell CAP_SYS_NICE.
#
# Amplifier mute/unmute is deliberately NOT automated here until the physical
# KAB9 control polarity and fail-safe hardware path pass G7.

[Install]
WantedBy=default.target
