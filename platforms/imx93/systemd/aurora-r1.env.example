# Copy to ~/.config/aurora/r1.env for the dedicated Aurora appliance user.
# Paths assume Aurora is installed at /opt/aurora and pinned third parties are
# built under /opt/aurora-deps.
AURORA_EARC_DEVICE=hw:AuroraEARC,0
AURORA_TDM_DEVICE=hw:AuroraTDM16,0
AURORA_DEPS_ROOT=/opt/aurora-deps
AURORA_EXTRACTOR=/opt/aurora/target/release/aurora-iec61937-extract
AURORA_ALSA_OUT=/opt/aurora/target/release/aurora-alsa-out
AURORA_HARLETTY_BRIDGE=/opt/aurora-deps/harletty-bridge/target/release/libharletty_bridge.so
AURORA_ORENDER=/opt/aurora-deps/Omniphony/omniphony-renderer/target/release/orender
AURORA_SPEAKER_LAYOUT=/opt/aurora/platforms/imx93/layouts/aurora-7.1.4.yaml

# Conservative R1 bring-up defaults. Tune only from measured queue/clock data.
AURORA_OUTPUT_GAIN_DB=-3.0
AURORA_MAX_CLOCK_CORRECTION_PPM=300
AURORA_ALSA_QUEUE_MS=200
AURORA_ALSA_TARGET_MS=80
