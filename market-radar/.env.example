# Streaming market data: consolidated SIP entitlement is needed for market-wide volume.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_FEED=sip
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
RADAR_INGEST_TOKEN=
RADAR_USER_AGENT=Ammar-MarketRadar/2.0 contact=REPLACE_WITH_EMAIL
RADAR_DB=runtime/radar.sqlite
RADAR_CONFIG=continuous/sources.json
# Optional external Radar Intelligence read-only Postgres bridge.
# Dedicated project must contain ONLY approved public-source monitoring.
RADAR_INTELLIGENCE_DSN=
RADAR_INTELLIGENCE_PROJECT_ID=
# Optional full universe JSON {"AAPL":["Apple Inc"],...}; use verified company aliases.
RADAR_UNIVERSE_FILE=
# 1 enables SEC issuer directory rather than the supplied focused universe.
# Bootstrap of all symbols takes longer and requires matching streaming entitlement.
RADAR_FULL_UNIVERSE=0
