[Unit]
Description=Market Radar always-on catalyst/tape daemon
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Auroraaudio/market-radar/live
ExecStart=/usr/bin/python3 /opt/Auroraaudio/market-radar/live/daemon.py --interval 20
Restart=always
RestartSec=3
EnvironmentFile=-/etc/market-radar.env
User=market-radar
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
