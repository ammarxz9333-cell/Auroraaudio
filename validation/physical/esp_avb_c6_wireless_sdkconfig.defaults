# Aurora exact-pin ESP32-C6 wireless AVB endpoint build profile.
# Build-only credentials are intentionally not embedded. This file selects
# the native Wi-Fi STA + software-clock gPTP topology and leaves runtime
# association/provisioning outside the compile proof.

CONFIG_ESP_PTP=y
CONFIG_ESP_PTP_GPTP_PROFILE=y
CONFIG_ESP_PTP_CLIENT=y
# CONFIG_ESP_PTP_SERVER is not set
CONFIG_ESP_PTP_NUM_PORTS=1

# Native C6 Wi-Fi endpoint: one primary AHB-attached Wi-Fi/FTM port in STA mode.
CONFIG_ESP_PTP_PORT0_MEDIUM_WIFI_FTM=y
# CONFIG_ESP_PTP_PORT0_MEDIUM_ETH_HWTS is not set
CONFIG_ESP_PTP_PORT0_HOST_IF_AHB=y
# CONFIG_ESP_PTP_PORT0_HOST_IF_EMAC is not set
# CONFIG_ESP_PTP_PORT0_HOST_IF_SDIO is not set
# CONFIG_ESP_PTP_PORT0_HOST_IF_SPI is not set
# CONFIG_ESP_PTP_PORT0_HOST_IF_USB is not set
# CONFIG_ESP_PTP_PORT0_HOST_IF_OTHER is not set
CONFIG_ESP_PTP_PORT0_TYPE_PRIMARY=y
# CONFIG_ESP_PTP_PORT0_TYPE_FAILOVER is not set
# CONFIG_ESP_PTP_PORT0_TYPE_BRIDGED is not set
CONFIG_ESP_PTP_PORT0_WIFI_MODE_STA=y
# CONFIG_ESP_PTP_PORT0_WIFI_MODE_AP is not set
CONFIG_ESP_PTP_PORT0_LINK_SPEED_MBPS=150

# Keep diagnostics disabled in the production-shaped compile lane.
# CONFIG_ESP_PTP_PEER_LOSS_TEST is not set
# CONFIG_ESP_PTP_INTERVAL_PROBE is not set
# CONFIG_ESP_PTP_CAPABLE_TX_TRACE is not set
# CONFIG_ESP_PTP_CAPABLE_RX_TRACE is not set
# CONFIG_ESP_PTP_SYNC_INTERVAL_PROBE is not set
# CONFIG_ESP_PTP_SOURCE_LOSS_PROBE is not set
# CONFIG_ESP_PTP_ANNOUNCE_PATH_PROBE is not set
