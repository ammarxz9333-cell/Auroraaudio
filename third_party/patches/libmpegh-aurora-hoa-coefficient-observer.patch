diff --git a/decoder/impeghd_api.c b/decoder/impeghd_api.c
index 6414ca8..0000000 100644
--- a/decoder/impeghd_api.c
+++ b/decoder/impeghd_api.c
@@ -1,3 +1,31 @@
+/* Aurora extension: expose post-spatial, pre-render HOA ACN/N3D coefficients.
+ * This does not change the existing public input/output configuration ABI. */
+WORD32 aurora_mpegh_set_hoa_coeff_observer(pVOID process_api_obj, pFLOAT32 buffer,
+                                            UWORD32 capacity_floats,
+                                            pUWORD32 written_floats,
+                                            pUWORD32 order,
+                                            pUWORD32 frame_length)
+{
+  ia_mpegh_dec_api_struct *api = (ia_mpegh_dec_api_struct *)process_api_obj;
+  if (api == NULL)
+    return -1;
+  if ((buffer == NULL) != (capacity_floats == 0))
+    return -2;
+  api->mpeghd_config.aurora_hoa_coeff_buf = buffer;
+  api->mpeghd_config.aurora_hoa_coeff_capacity_floats = capacity_floats;
+  api->mpeghd_config.aurora_hoa_coeff_written_floats = written_floats;
+  api->mpeghd_config.aurora_hoa_coeff_order = order;
+  api->mpeghd_config.aurora_hoa_coeff_frame_length = frame_length;
+  if (written_floats != NULL)
+    *written_floats = 0;
+  if (order != NULL)
+    *order = 0;
+  if (frame_length != NULL)
+    *frame_length = 0;
+  return 0;
+}
